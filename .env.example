# Reown project id (kitbox modal)
VITE_PROJECT_ID=

# Gnosis chain
VITE_CHAIN=gnosis
VITE_RPC_URL=

# Proxy address of LimitOrderReader (the contract with getUserInfo / getUsersInfo)
VITE_READER_ADDRESS=

# ---- scripts/snapshot.js only (not sent to the browser) ----
# RPC used to build the snapshot. Archive RPC needed if SNAPSHOT_BLOCK is old.
SNAPSHOT_RPC=https://rpc.gnosischain.com
# Block to freeze balances at. Empty = latest block when the script starts.
SNAPSHOT_BLOCK=
# Deploy block of each contract: scanning starts here.
# Use the EARLIEST of the three if unsure: starting later than a deploy misses its first transfers.
START_BLOCK_A=38638336
START_BLOCK_B=38638336
START_BLOCK_LIMIT_ORDER=38638336
